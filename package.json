{
  "name": "@nakedev/sveltekit-fsd",
  "version": "0.1.4",
  "description": "Keep a SvelteKit project on Feature-Sliced Design: init the layout, generate slices, add auth and API error handling",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NakePranob/sveltekit-fsd.git"
  },
  "bin": {
    "sveltekit-fsd": "bin/sveltekit-fsd.js"
  },
  "files": [
    "dist",
    "templates",
    "bin",
    "LICENSE"
  ],
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test tests/*.test.mjs && node scripts/smoke-test.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:integration": "node scripts/integration-test.mjs",
    "verify": "npm run build && npm test",
    "release:check": "node scripts/check-release.mjs",
    "prepack": "rm -rf dist && npm run build",
    "prepublishOnly": "npm run release:check && npm run verify"
  },
  "keywords": [
    "sveltekit",
    "svelte",
    "feature-sliced",
    "fsd",
    "scaffold",
    "cli",
    "generator"
  ],
  "author": "nakedev",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.5.1",
    "commander": "^15.0.0",
    "fs-extra": "^11.3.0",
    "handlebars": "^4.7.8",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.0.0",
    "steiger": "^0.6.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
