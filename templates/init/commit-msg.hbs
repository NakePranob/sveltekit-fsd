#!/bin/sh
# Conventional Commit subjects, checked where they are written instead of in
# review: the subject is the one part of a commit nobody goes back and edits.
#
# Shape only, on purpose. Which language you write in, whether a ticket number
# rides along, and whether you use an emoji are this project's calls — write
# them down in AGENTS.md, and extend this hook if you want them enforced.
subject=$(head -n 1 "$1")

# A rebase helper, a merge, a revert, or the bare version a release tool writes.
case "$subject" in
fixup\!*|squash\!*|amend\!*|Merge\ *|Revert\ *) exit 0 ;;
esac
case "$subject" in
[0-9]*.[0-9]*.[0-9]*) exit 0 ;;
esac

if ! printf '%s' "$subject" |
	grep -Eq '^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9/._-]+\))?!?: .+'; then
	echo "commit subject is not a Conventional Commit:"
	echo "  $subject"
	echo
	echo "  type(optional-scope): what changed"
	echo "  build chore ci docs feat fix perf refactor revert style test"
	exit 1
fi
