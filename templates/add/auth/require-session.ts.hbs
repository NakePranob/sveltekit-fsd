import { goto } from "$app/navigation";
import { resolve } from "$app/paths";
import { page } from "$app/state";

import { useSession } from "./session";

/**
 * Session for a page that needs one, sending anonymous visitors to /login.
 *
 * This module is `.svelte.ts` because of the `$effect` below — runes are
 * compiled, and the compiler only looks inside `.svelte` components and modules
 * named this way. In a plain `.ts` the call survives as a bare identifier and
 * the page throws `$effect is not defined` at request time, with the types and
 * the build both green. `safeNext` lives in its own plain module for the
 * opposite reason: it is pure, it is the part worth unit-testing, and inside a
 * runes module `svelte/prefer-svelte-reactivity` reads its throwaway `URL` as
 * reactive state.
 *
 * Call it from a component's `<script>` — it registers an effect, and `$effect`
 * only exists during component initialisation.
 *
 * UX only — the real gate is the API's own auth middleware, which every request
 * passes through regardless of what the browser rendered. It cannot move into
 * `hooks.server.ts` either: the refresh cookie belongs to the API's origin, so
 * the SvelteKit server never sees it and has nothing to check.
 *
 * The path travels as `?next=`, so a deep link survives the round trip. Path
 * only, no query string: a `next` carrying its own `?` has to be encoded
 * carefully at both ends, and nothing here needs it yet.
 */
export function requireSession() {
  const session = useSession();

  $effect(() => {
    // Through resolve(), not a bare string: it prepends `base`, so this keeps
    // working when the app is served from a sub-path.
    if (session.isError) {
      void goto(resolve(`/login?next=${encodeURIComponent(page.url.pathname)}`), { replaceState: true });
    }
  });

  return session;
}
