import { env } from "$env/dynamic/public";

// Base URL of the API, including whatever prefix it mounts its routes under —
// the prefix belongs here rather than in every request path.
//
// `$env/dynamic/public`, not `$env/static/public`: the static form is inlined at
// build time and **fails the build** when the variable is unset, so a fresh
// clone with no .env cannot even start. The dynamic form is read at runtime,
// which also means one built image can be pointed at staging or production
// without rebuilding. Only `PUBLIC_`-prefixed variables are exposed to the
// browser, which is the rule that keeps a secret from leaking into a bundle.
export const API_URL = env.PUBLIC_API_URL ?? "http://localhost:8080/api";
